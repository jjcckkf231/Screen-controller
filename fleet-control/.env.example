# Default: local PostgreSQL-compatible PGlite, only accessible on this computer.
HOST=127.0.0.1
PORT=4178
FLEET_DATA_DIR=.data
# Set DATABASE_URL to use a full PostgreSQL instance instead of PGlite.
# DATABASE_URL=postgres://fleet:YOUR_PASSWORD@localhost:5432/fleet
# For a remote HTTPS deployment, set PUBLIC_ORIGIN and require secure cookies.
# PUBLIC_ORIGIN=https://your-fleet-app.example
# SECURE_COOKIES=true
# Worker/API shared secret: generate a random value for production.
# FLEET_WORKER_TOKEN=
# FLEET_API_URL=http://127.0.0.1:4178
# Set only after provisioning the connector; the app defaults to disconnected.
# XIAOHUI_AUTH_FILE=.data/xiaohui-session.enc
# XIAOHUI_CONFIG_FILE=config/xiaohui.json
