{
  "name": "fleet-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "start": "tsx server/main.ts",
    "worker": "tsx worker/main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "playwright test",
    "connect": "tsx worker/connect.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.7",
    "@js-temporal/polyfill": "^0.5.1",
    "fastify": "5.12.7",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.20.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
